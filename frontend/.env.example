# Kopyala: frontend/.env.local  (git'e girmez)

# Sunucu tarafi cizimin backend'e giderken kullandigi anahtar — backend/.env'deki INTERNAL_API_KEY ile AYNI olmali.
# Tarayiciya hic gitmez (NEXT_PUBLIC_ degil). Tek basina yonetici sayilmaz, kullanicinin cereziyle birlikte gider.
INTERNAL_API_KEY=

# Backend adresi — yerelde gerekmez (varsayilan http://127.0.0.1:8000; backend sadece 127.0.0.1 dinler).
# Eski bulut kurulumunda (Vercel → Render) Render adresiydi.
# BACKEND_URL=http://127.0.0.1:8000
