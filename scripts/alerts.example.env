# Nortverse dis uyarilari (Sprint 94 D4, K12). Bu dosyayi alerts.local.env adiyla kopyalayip doldurun.
# alerts.local.env git'e girmez. Bos birakilan satir kapalidir; hicbiri doluysa dis servise hicbir sey gitmez.
#
# ntfy.sh: telefona anlik bildirim. Telefona ntfy uygulamasini kurun, tahmin edilmesi zor bir konu adi secip
# abone olun (or. nortverse-7f3k9q2x) ve ayni adi buraya yazin. Uyari metinleri bu konuya gider.
NTFY_TOPIC=
#
# healthchecks.io: olu adam anahtari. Ucretsiz hesap -> proje -> Settings -> "Ping key" olusturun, buraya yazin.
# Kontroller ilk pingte kendiliginden olusur: nortverse-saglik (15 dk), nortverse-pipeline, nortverse-skor,
# nortverse-yedek. healthchecks.io'da her kontrolun takvimini ayarlayin (or. saglik: "*/15 11-23,0-1 * * *",
# Europe/Istanbul) ve bildirim kanalina telefonu ekleyin. Bilgisayar uyur/kapanirsa ping gelmez -> haber verir.
HC_PING_KEY=
#
# Bulut yedek klasoru (D3 sifreli haftalik yedek kurulunca): saglik kontrolu son kopyanin yasini bakar.
CLOUD_BACKUP_DIR=
