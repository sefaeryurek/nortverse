# Kopyala: backend/.env  (git'e girmez). Yorumlu satırlar koddaki varsayılanı gösterir.

# --- Veritabani ---
# Local Docker (docker-compose.yml): sifreyi kendi kurulumunla degistir
DATABASE_URL=postgresql+asyncpg://nortverse:nortverse_local@127.0.0.1:5433/nortverse

# Alembic sync URL (opsiyonel — yoksa DATABASE_URL'den otomatik turetilir)
# DATABASE_URL_SYNC=postgresql+psycopg2://nortverse:nortverse_local@127.0.0.1:5433/nortverse

# --- DB Pool ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_STATEMENT_CACHE_SIZE=100
# DB_POOL_RECYCLE=3600

# --- Giris / guvenlik (Sprint 93-94) ---
# Tum /api ve /ws uclari oturum ister. Sadece testlerde 0 yapilir.
# AUTH_REQUIRED=1
# Sunucu tarafi cizim anahtari — frontend/.env.local'daki INTERNAL_API_KEY ile AYNI olmali.
# Tek basina yonetici sayilmaz, kullanicinin cereziyle birlikte gider (Sprint 94 E1). Uzun rastgele deger:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# /api/admin/* icin ek anahtar (X-Admin-Key). Bos = ek anahtar istenmez, giris yapmis her kullanici erisir
# ADMIN_API_KEY=
# Not: X-Forwarded-For hic guvenilmez (Sprint 94 E3); eski TRUSTED_PROXIES ayari kaldirildi.

# --- CORS ---
# CORS_ORIGINS=http://localhost:3000,https://nortverse.vercel.app

# --- Arka plan isleri ---
# 0: canli izleyici ve WebSocket yayincisi baslamaz, kaynaga istek gitmez (CI E2E / deneme)
# BACKGROUND_JOBS=1

# --- Log ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text          # json da olur

# --- Scraper ---
# SCRAPER_BASE_URL=https://live5.nowgoal26.com
# SCRAPER_HEADLESS=true
# SCRAPER_TIMEOUT=30.0
# SCRAPER_WAIT=4.0
# PLAYWRIGHT_MAX_CONCURRENCY=2     # ayni anda en fazla Chromium (her biri ~300 MB)

# --- Oranlar (Sprint 93-94) ---
# ODDS_BASE_URL=https://live.nowgoal.life
# ODDS_MAX_CONCURRENCY=4
# ODDS_REQUESTS_PER_SECOND=1.0     # evin IP'si kaynakta engellenmesin

# --- Analiz Motoru ---
# ANALYSIS_N_MATCHES=5
# ANALYSIS_THRESHOLD=3.5
# ANALYSIS_MIN_H2H=5
# ANALYSIS_MIN_LEAGUE_MATCHES=5

# --- Degerlendirme / Kalibrasyon ---
# RESULT_SHRINKAGE=0.45
# SHRINKAGE_HALF_LIFE=15
# RESULT_MIN_MARGIN=10.0
# EVAL_MIN_MATCHES=5
# MIN_ARCHIVE_MATCHES=10           # bir arsiv (A1/A2/A3) en az bu kadar maçla sayilir

# --- A2 / Pattern C (algoritma c4: sabit ±1,0 — Sprint 91 Faz 4) ---
# PATTERN_C_TOLERANCE=1.0
# PATTERN_C_MAX_TOLERANCE=1.0
# PATTERN_C_TOLERANCE_STEP=0.25
# PATTERN_C_ADAPTIVE_MIN=3

# --- A3 / Pattern D (algoritma d4: takim gucu λ'sina en yakin K maç — Sprint 91 Faz 4) ---
# PATTERN_D_TOP_K=200
# PATTERN_D_MIN_MATCHES=10
# (eski PATTERN_D_TOP_N / PATTERN_D_MIN_SIMILARITY kosinus ayarlari kaldirildi)

# --- Temporal Decay ---
# TEMPORAL_DECAY_HALF_LIFE=3.0

# --- Match Cap ---
# PATTERN_B_MATCH_CAP=150
# PATTERN_C_MATCH_CAP=150
