# --- Veritabani ---
# Local Docker: postgresql+asyncpg://nortverse:nortverse_local@localhost:5433/nortverse
# Neon: postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/nortverse
DATABASE_URL=postgresql+asyncpg://nortverse:nortverse_local@localhost:5433/nortverse

# Alembic sync URL (opsiyonel — yoksa DATABASE_URL'den otomatik turetilir)
# DATABASE_URL_SYNC=postgresql+psycopg2://nortverse:nortverse_local@localhost:5433/nortverse

# --- DB Pool ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_STATEMENT_CACHE_SIZE=100
# DB_POOL_RECYCLE=3600

# --- Scraper ---
# SCRAPER_BASE_URL=https://live5.nowgoal26.com
# SCRAPER_HEADLESS=true
# SCRAPER_TIMEOUT=30.0
# SCRAPER_WAIT=4.0

# --- Analiz Motoru ---
# ANALYSIS_N_MATCHES=5
# ANALYSIS_THRESHOLD=3.5
# ANALYSIS_MIN_H2H=5
# ANALYSIS_MIN_LEAGUE_MATCHES=5

# --- Degerlendirme / Kalibrasyon ---
# PATTERN_C_TOLERANCE=0.5
# RESULT_SHRINKAGE=0.45
# SHRINKAGE_HALF_LIFE=15
# OVER_25_BASE_RATE=55.4
# BTTS_BASE_RATE=55.4
# RESULT_MIN_MARGIN=8.0
# OVER_25_THRESHOLD=55.0
# BTTS_THRESHOLD=55.0
# EVAL_MIN_MATCHES=5

# --- CORS ---
# CORS_ORIGINS=http://localhost:3000,https://nortverse.vercel.app
